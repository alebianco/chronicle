<?xml version="1.0" encoding="utf-8"?>
<!-- One grouped-search heading and how many books it found (cu-25). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/screen_horizontal_padding"
    android:paddingTop="@dimen/margin_normal"
    android:paddingEnd="@dimen/screen_horizontal_padding"
    android:paddingBottom="@dimen/margin_small">

    <TextView
        android:id="@+id/search_header_label"
        style="@style/TextAppearance.SectionHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@id/search_header_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Narrators" />

    <TextView
        android:id="@+id/search_header_count"
        style="@style/TextAppearance.Body2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/textSecondary"
        app:layout_constraintBottom_toBottomOf="@id/search_header_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/search_header_label"
        tools:text="3 books" />

</androidx.constraintlayout.widget.ConstraintLayout>
