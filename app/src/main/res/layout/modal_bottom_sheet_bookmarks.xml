<?xml version="1.0" encoding="utf-8"?>
<!-- The bookmarks of the book being played (cu-22): tap to jump, pencil to edit or delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bookmarks_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_handle_height"
        android:background="@color/colorPrimary">

        <TextView
            style="@style/TextAppearance.Subtitle.Settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/screen_horizontal_padding"
            android:text="@string/bookmarks_title"
            android:textColor="@color/textPrimary"
            android:textSize="16sp" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark">

        <!--
          The list and its empty message are `BookmarkList` now (cu-203). The `maxHeight` stays on
          this host: a book with many bookmarks would otherwise make the sheet fill the screen,
          and Compose has no `maxHeight` on `LazyColumn` — it is a constraint on the container.
        -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/bookmarks_compose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/bookmark_list_max_height" />

    </FrameLayout>

</LinearLayout>
