<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    tools:context=".features.home.HomeFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ToolbarTheme"
            app:collapseIcon="@drawable/ic_search_white"
            app:layout_constraintTop_toTopOf="parent"
            app:menu="@menu/home_menu"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
            app:title="@string/tab_home" />
    </com.google.android.material.appbar.AppBarLayout>

    <io.github.mattpvaughn.chronicle.views.HorizontalChildReadySwipeRefreshLayout
        android:id="@+id/swipe_to_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_layout">

        <!--
          The three shelves and all three empty states are `HomeScreen` now (cu-201). The
          `ScrollView` and its nested `LinearLayout` of titles and RecyclerViews go with them, as
          do the two `gone` empty-state views above: those states are a sealed `HomeContent`
          seeded to `Loading`, so nothing can claim an empty library before the first emission.

          `HorizontalChildReadySwipeRefreshLayout` stays as the host — it is the
          horizontal-child-aware subclass, whose `onInterceptTouchEvent` declines the pull once
          horizontal slop is exceeded. That arbitration exists *because* the shelves scroll
          sideways, and reimplementing it in Compose buys nothing.
        -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/home_compose"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </io.github.mattpvaughn.chronicle.views.HorizontalChildReadySwipeRefreshLayout>

    <!--
      The search overlay is `SearchOverlay` now (cu-202), drawn inside `home_compose` so it covers
      the shelves the way this RecyclerView's `elevation="8dp"` did. Home never had a "no results"
      message where library and collections did; the shared `searchOverlayState` gives all three
      the same answer, so that drift cannot return.
    -->
</androidx.constraintlayout.widget.ConstraintLayout>
