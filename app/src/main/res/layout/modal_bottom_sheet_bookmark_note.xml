<?xml version="1.0" encoding="utf-8"?>
<!--
  Editing a bookmark's note (cu-22).

  A bottom sheet rather than a dialog, because that is what this app uses for every other
  transient choice — there is no AlertDialog anywhere in the codebase and introducing one here
  would make the note the odd surface out.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bookmark_note_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_handle_height"
        android:background="@color/colorPrimary">

        <TextView
            android:id="@+id/bookmark_note_title"
            style="@style/TextAppearance.Subtitle.Settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/screen_horizontal_padding"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            tools:text="Bookmark at 1:02:33" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/margin_normal"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/margin_normal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/bookmark_note_input"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bookmark_note_hint"
            app:boxBackgroundColor="@color/colorPrimaryDark"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/material_text_input_layout_outline"
            app:hintTextColor="@color/colorAccent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/bookmark_note_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minLines="2" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bookmark_note_delete"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookmark_delete"
                android:textAllCaps="false"
                android:textColor="@color/icon" />

            <Button
                android:id="@+id/bookmark_note_save"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookmark_save"
                android:textAllCaps="false"
                android:textColor="@color/colorAccent"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
