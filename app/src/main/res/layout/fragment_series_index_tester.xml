<?xml version="1.0" encoding="utf-8"?>
<!--
  The series-numbering rules tester (cu-151).

  The input box, the verdict, the rule list, the library summary and the sample titles are all
  `SeriesIndexTesterScreen` now (cu-202). That replaces a `NestedScrollView` wrapping two
  `nestedScrollingEnabled="false"` RecyclerViews — which measures every row of both lists eagerly —
  plus eight `isVisible` decisions and a guarded two-way text sync. The toolbar stays a View: it
  owns the up-navigation contract with the FragmentManager.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ToolbarTheme"
            app:navigationIcon="@drawable/ic_arrow_back_white"
            app:title="@string/series_rules_screen_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/tester_compose"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
