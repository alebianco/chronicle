<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimaryDark"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            android:minHeight="?attr/actionBarSize"
            app:titleEnabled="false">

            <!--
              The header is `DetailsScreen` now (cu-200): artwork, title, author, narrator/series,
              the progress line, the download control, play/pause and the collapsible summary.

              `layout_collapseMode="parallax"` with a one-action-bar top margin, exactly as the
              player took in cu-198 — the toolbar below is `pin`ned, and without the margin the
              first row renders behind it. The margin is what stops cu-105's bug class returning:
              the pinned bar keeps the status-bar strip and the scrolling content never draws over
              the toolbar.

              The pinned bar stays a View. The chapter list moved into the
              same `LazyColumn` as the header in cu-201, so it scrolls with it rather than being a
              second scroll container coordinating through `appbar_scrolling_view_behavior`.
            -->

            <LinearLayout
                android:id="@+id/pinned_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryDark"
                android:orientation="vertical"
                app:layout_collapseMode="pin">

                <FrameLayout
                    android:id="@+id/connectivity_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="1dp">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/connecting_to_server_indicator"
                        android:visibility="gone"
                        tools:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorColor="@color/colorAccent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/connection_failed_message"
                        android:visibility="gone"
                        tools:visibility="visible"
                        style="@style/TextAppearance.Body1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@color/textError"
                        android:drawableEnd="@drawable/ic_refresh_white"
                        android:padding="@dimen/spacing_normal"
                        android:text="@string/failed_to_connect_to_server"
                        android:textAlignment="center" />

                </FrameLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/details_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@color/colorPrimaryDark"
                    app:menu="@menu/audiobook_details_menu"
                    app:navigationIcon="@drawable/ic_arrow_back_white"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

            </LinearLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!--
      The whole screen body is Compose and it owns its own scrolling (`LazyColumn`), so it is the
      CoordinatorLayout's **scrolling child** rather than a `parallax` view inside the collapsing
      header. Two things forced this in cu-201: a `LazyColumn` inside a `wrap_content` ComposeView
      is measured with infinite height and throws outright, and nesting a scroller inside a
      collapsing header means two scroll containers fighting — which is what
      `appbar_scrolling_view_behavior` was arbitrating for the old RecyclerView.
    -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/details_compose"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />



</androidx.coordinatorlayout.widget.CoordinatorLayout>
