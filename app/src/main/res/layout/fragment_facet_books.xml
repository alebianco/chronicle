<?xml version="1.0" encoding="utf-8"?>
<!--
  The books under one facet value — an author, a narrator, a series (cu-24).

  Structurally the same as fragment_collection_details.xml, which is the existing precedent for a
  filtered book list. Copied rather than shared because the ids read as what they are here; a
  binding called `collectionsGrid` on a narrator screen is the kind of small lie that makes code
  harder to follow later.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ToolbarTheme"
            app:navigationIcon="@drawable/ic_arrow_back_white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- The grid and its empty message are `BookGrid` now (cu-201). -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/facet_books_compose"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
