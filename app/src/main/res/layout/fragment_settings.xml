<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark">


    <!--
      The rows are `SettingsScreen` now (cu-199). `SettingsList` — a FrameLayout wrapping a
      programmatic RecyclerView, three ViewHolders and a DiffUtil — is deleted with it.

      The chooser is `BottomChooser` now (cu-203) — a `ModalBottomSheet` drawing in its own
      window, so it needs no elevation and no place in this hierarchy.
    -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/settings_compose"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
