<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimaryDark"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            android:minHeight="?attr/actionBarSize">

            <!--
              The player body is `PlayerScreen` now (cu-198). What this replaces: a 300-line
              ConstraintLayout whose `details_artwork` carried
              `@integer/currently_playing_artwork_visibility` — GONE in `values-land` — which is
              why cu-19's guard, anchored on a view that orientation hid, blanked the whole text
              block in landscape. Compose branches on an orientation boolean the Fragment passes,
              where it can be read.

              The toolbar below, the chapter `RecyclerView` and both `BottomSheetChooser`s stay as
              Views: the toolbar owns the collapsing-scroll contract with the list, the chapter
              adapter is shared with the details screen, and the choosers are shared animated
              widgets. Same call `CollectionsFragment` made for `SwipeRefreshLayout` (cu-187).
            -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/player_compose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/actionBarSize"
                app:layout_collapseMode="parallax" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/details_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/colorPrimaryDark"
                app:layout_collapseMode="pin"
                app:menu="@menu/currently_playing_menu"
                app:navigationIcon="@drawable/ic_arrow_back_white" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tracks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorPrimaryDark"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <ProgressBar
        android:id="@+id/loading_tracks_spinner"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="@dimen/margin_normal"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintTop_toTopOf="@id/tracks" />

    <io.github.mattpvaughn.chronicle.views.BottomSheetChooser
        android:id="@+id/bottom_sheet_chooser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp" />

    <io.github.mattpvaughn.chronicle.views.BottomSheetChooser
        android:id="@+id/sleep_timer_chooser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp"
        app:layout_anchor="@+id/bottom_sheet_chooser"
        app:layout_anchorGravity="center" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
