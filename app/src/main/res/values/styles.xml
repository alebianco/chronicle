<resources>

    <!--
      The window theme, and the only style left in this file.

      It is still required, and is not migration residue: `MainActivity` remains an
      `AppCompatActivity` (theming, day/night, and `ComposeView` needs a host), and
      `AndroidManifest.xml` names this theme for the window background and system bars before any
      composable exists. That is why `colors.xml` cannot be retired while this stands.

      Everything else that used to live here styled View-system widgets and went with the last XML
      layout. `chipStyle` / `chipGroupStyle` went with them: the only `FilterChip` left in the tree
      is `androidx.compose.material3.FilterChip`, which is a different widget entirely and takes no
      theme attribute from here.
    -->
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:fontFamily">@font/lato</item>
    </style>

</resources>
