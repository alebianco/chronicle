{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-kotlin.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/memory-hygiene.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./verify.sh:*)",
      "Bash(./gradlew:*)",
      "Bash(./coverage-ratchet.sh:*)",
      "Bash(./test_release_build.sh:*)",
      "Bash(./capture-screens.sh:*)",
      "Bash(./plex-session.sh:*)",
      "Bash(./measure-audio-glitches.sh:*)",
      "Bash(./list-build-gates.sh:*)",
      "Bash(backlog:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(git stash list:*)",
      "Bash(adb devices:*)",
      "Bash(adb -s * shell dumpsys:*)",
      "Bash(adb -s * shell input:*)",
      "Bash(adb -s * shell am start:*)",
      "Bash(adb -s * shell am force-stop:*)",
      "Bash(adb -s * shell screencap:*)",
      "Bash(adb -s * logcat:*)",
      "Bash(command ls:*)",
      "Bash(command grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)"
    ]
  }
}
